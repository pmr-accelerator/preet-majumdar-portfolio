# Required for database-backed operation
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/preet_portfolio?sslmode=require"

# Generate a long random value; never commit the real value
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

# S3-compatible durable media storage (configure before enabling uploads)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Transactional email (configure before claiming email notifications work)
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL=""

# First-admin bootstrap is performed by the one-time CLI command; do not expose these publicly
